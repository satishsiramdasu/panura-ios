<?xml version="1.0" encoding="UTF-8"?>
<!--
  App privacy manifest. Required by App Store Connect since spring 2024: an
  upload without one is rejected, and one that omits a "required reason" API the
  binary actually calls is rejected too.

  Two halves:

  * NSPrivacyAccessedAPITypes — APIs Apple considers fingerprinting-capable. Only
    what THIS app calls; every SPM dependency ships its own manifest for its own
    calls (GoogleMobileAds, GoogleCast and VLCKit each do).
  * The tracking and collection keys — what leaves the device, and whether any of
    it is used to follow a user across other companies' apps.

  KEEP THIS IN STEP WITH THE CODE. Two changes in particular invalidate it:
  turning ads on (see NSPrivacyTracking below), and any change to what Firebase
  is allowed to collect.
-->
<plist version="1.0">
<dict>
    <!--
      False while FeatureFlags.adsEnabled is false: nothing in the app follows a
      user anywhere.

      ⚠️ Switching ads on means one of two things. Personalised ads through
      AdMob ARE tracking: set this to true, add Google's ad domains to
      NSPrivacyTrackingDomains, and the ATT prompt becomes mandatory. Serving
      non-personalised ads only (AdManager forces `npa=1` when ATT is refused or
      undetermined) keeps this false.
    -->
    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!--
      What Firebase sends, since Crashlytics and Analytics were added on
      2026-09-15 to match Android:

        CrashData, OtherDiagnosticData   Crashlytics: stack traces, device model,
                                         OS version, memory and disk at the crash
        ProductInteraction               Analytics' automatic events: first open,
                                         sessions, screens viewed
        DeviceID                         Firebase's app instance id. NOT the
                                         advertising identifier: FirebaseAnalytics
                                         without the identity-support module never
                                         reads IDFA, and ATT is never requested
        CoarseLocation                   country or region, derived from the IP

      None of it is linked to an identity (the app has no accounts) and none is
      used for tracking, so NSPrivacyTracking above stays false. Firebase ships a
      manifest declaring the same; it is declared here as well because it is now
      the app's own collection, not only an SDK's.

      Still never collected: browsing history, shortcuts, resume points and
      detected streams, which stay on this device. Analytics' automatic screen
      events name the app's screens, never the pages visited. A report the user
      types themselves goes to Panura's own worker and is not linked to anyone.

      Keep this in step with the App Privacy answers in App Store Connect.
    -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!--
          UserDefaults, everywhere: settings, shortcuts, history, resume
          positions. CA92.1 is the reason for reading and writing a container
          the app alone can see, which is exactly this — no app group, no shared
          suite.
        -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
